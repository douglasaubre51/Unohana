@{
    ViewData["Title"] = "Home";
}

<style>
    .hero-content {
        display: flex;
        flex-direction: column;
        gap: 4px;

        justify-content: center;
        margin-top: 10%;
    }
</style>

<div class="hero-content">
    <h1 class="display-2">Unohana</h1>

    <a class="auth-link" asp-controller="Auth" asp-action="StudentSignIn">
        <button class="primary-btn" style="width:240px">Student SignIn</button>
    </a>
    <a class="auth-link" asp-controller="Auth" asp-action="TutorSignIn">
        <button class="primary-btn" style="width:240px">Tutor SignIn</button>
    </a>
</div>