@using System.Diagnostics.Eventing.Reader
@model ChatViewModel

@{
    ViewData["Title"] = "Channels";
}

<div class="grid-contain">
    <div class="chat-list">
        @foreach (var i in @Model.Channels!)
        {
            <a class="chat-card" asp-action="LoadChatRoom" asp-controller="Student" asp-route-id="@i.Id">
                <span class="card-title">@i.Title</span>
            </a>
        }
    </div>

    <div class="spacer"></div>

    @if (@Model is not null && @Model.CurrentChannel is not null)
    {
        <div class="chat-room">
            <span class="display-6">@Model.CurrentChannel.Title</span>
            <hr />

            @if (@Model.CurrentChannel.Messages is not null)
            {
                <div id='message-contain' class="message-collection">
                    @foreach (var m in @Model.CurrentChannel.Messages)
                    {
                        <div class="message-card">
                            <span class="message-text">@m.Text</span>
                            <span class="message-time">@m.CreatedAt</span>
                            <span class="message-author">@m.Tutor.FirstName @m.Tutor.LastName</span>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<input type='hidden' id='channel-id' value='@Model!.CurrentChannel!.Id' />
<input type='hidden' id='user-id' value='@Model!.UserId' />

<script src="~/lib/signalr/signalr.js"></script>
<script src="~/js/student_chat.js"></script>