@using Unohana.ViewModels.Auth

@model StudentSignInViewModel

@{
    ViewData["Title"] = "Student SignIn";
}

<form asp-action="StudentSignIn" asp-controller="Auth" method="post">
    <div class="center-content">
        <h1 class="display-4">Student SignIn</h1>

        <span class="label">Email</span>
        <span asp-validation-for="@Model.Email" class="invalid-error-label"></span>
        <input asp-for="@Model.Email" class="text-box" type="text" />

        <span class="label">Password</span>
        <span asp-validation-for="@Model.Password" class="invalid-error-label"></span>
        <input asp-for="@Model.Password" class="text-box" type="password" />

        @if (@Model is not null && @Model.InvalidCredentials is true)
        {
            <span class="invalid-error-label">Invalid Login Attempt !</span>
        }

        <button class="primary-btn">continue</button>

        <a asp-action="StudentSignUp" asp-controller="Auth">don't have an account ?</a>
    </div>
</form>