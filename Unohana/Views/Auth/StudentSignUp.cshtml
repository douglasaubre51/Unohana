@using Unohana.ViewModels.Auth

@model StudentSignUpViewModel

@{
    ViewData["Title"] = "Student SignUp";
}

<form asp-action="StudentSignUp" asp-controller="Auth" method="post">
    <div class="center-content">
        <h1 class="display-4">Create new Student Account</h1>

        <span class="label">First name</span>
        <span asp-validation-for="@Model.FirstName" class="invalid-error-label"></span>
        <input asp-for="@Model.FirstName" class="text-box" type="text" />

        <span class="label">Last name</span>
        <span asp-validation-for="@Model.LastName" class="invalid-error-label"></span>
        <input asp-for="@Model.LastName" class="text-box" type="text" />

        <span class="label">Student id</span>
        <span asp-validation-for="@Model.StudentId" class="invalid-error-label"></span>
        <input asp-for="@Model.StudentId" class="text-box" type="number" />

        <span class="label">Email</span>
        <span asp-validation-for="@Model.Email" class="invalid-error-label"></span>
        <input asp-for="@Model.Email" class="text-box" type="email" />

        <span class="label">Password</span>
        <span asp-validation-for="@Model.Password" class="invalid-error-label"></span>
        <input asp-for="@Model.Password" class="text-box" type="password" />

        @if (@Model is not null && @Model.DuplicateAccountError is true)
        {
            <span class="invalid-error-label">Account already exists !</span>
        }

        <button class="primary-btn">continue</button>

        <a asp-action="StudentSignIn" asp-controller="Auth">already have an account ?</a>
    </div>
</form>