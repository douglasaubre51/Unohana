@using System.Text
@using System.Diagnostics.Eventing.Reader
@using Unohana.ViewModels.Chat

@model ChatViewModel

@{
    ViewData["Title"] = "Channels";
}

<script src="~/js/tutor_view.js"></script>

<div class="grid-contain">
    <div class="chat-list">
        @if (@Model.Channels! is null || @Model.Channels.Count is 0)
        {
            <span class="info-label">Create channels to show notices!</span>
        }
        else
        {
            @foreach (var i in @Model.Channels!)
            {
                @if (@Model.CurrentChannel!.Id == i.Id)
                {
                    <a class="chat-card" style="background-color:lightgrey" asp-action="LoadChatRoom" asp-controller="Chat"
                        asp-route-id="@i.Id">
                        <span class="card-title">@i.Title</span>
                    </a>
                }
                else
                {
                    <a class="chat-card" asp-action="LoadChatRoom" asp-controller="Chat" asp-route-id="@i.Id">
                        <span class="card-title">@i.Title</span>
                    </a>
                }
            }
        }
    </div>

    <div class="spacer"></div>

    @if (@Model is not null && @Model.CurrentChannel is not null)
    {
        <div class="chat-room">
            <span class="display-6">@Model.CurrentChannel.Title</span>
            <hr />

            @if (@Model.CurrentChannel.Messages is not null)
            {
                <div id='message-contain' class="message-collection">
                    @foreach (var m in @Model.CurrentChannel.Messages)
                    {
                        <div class="message-card">
                            <span class="message-text">@m.Text</span>
                            <span class="message-time">@m.CreatedAt</span>
                            <span class="message-author">@m.Tutor.FirstName @m.Tutor.LastName</span>
                        </div>
                    }
                </div>
            }

            <form style="margin-top:auto">
                <div class="room-footer">
                    <input type="hidden" id="channel-id" asp-for="@Model.CurrentChannel.Id" />
                    <input type="hidden" id="user-id" asp-for="@Model.UserId" />

                    <textarea id="user-message" asp-for="@Model.Message" class="text-box" rows="5"></textarea>
                    <button id="send-btn" class="primary-btn">Send</button>
                </div>
            </form>
        </div>
    }
</div>

<script src="~/lib/signalr/signalr.js"></script>
<script src="~/js/chat.js"></script>